from dataclasses import dataclass

__all__ = ["AgentConfig"]

@dataclass
class AgentConfig:
    max_steps: int = ...
    convergence_threshold: float = ...
    @classmethod
    def from_yaml(cls, path: str) -> AgentConfig: ...
    def to_yaml(self, path: str) -> None: ...
    @classmethod
    def with_defaults(cls) -> AgentConfig: ...
